// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
  seed     = "ts-node prisma/seed.ts"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id  String @id @default(uuid())
  email String 
  firstName String?
  lastName String?
  password String?
  provider AuthProvider @default(CREDENTIALS)
  providerId String? // For Google/Apple ID
  role UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResets PasswordReset[]
  goals Goal[]
  sentMessages Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  channelMemberships ChannelMember[]

  @@unique([email, provider]) // Compound unique constraint
  @@index([email])
  @@index([providerId]) // Add index for faster providerId lookups
}

model PasswordReset {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([token])
  @@index([userId])
}

enum AuthProvider {
  GOOGLE
  APPLE 
  CREDENTIALS
}

enum UserRole {
  USER
  ADMIN
}

model Goal {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    GoalCategory
  deadline    DateTime?
  location    String?
  tags        String?  // Stored as comma-separated values
  reminderDate DateTime?
  isCompleted Boolean  @default(false)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([category])
}

enum GoalCategory {
  SCHEDULE
  FINANCE
  CAREER
  AUDIO_BOOKS
}

// Chat and Channel Models

model Message {
  id          String   @id @default(uuid())
  content     String   @db.Text
  read        Boolean  @default(false)
  
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  
  receiverId  String?
  receiver    User?    @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: SetNull)
  
  channelId   String?
  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
  @@index([channelId])
}

model Channel {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?  // URL or icon identifier
  type        ChannelType @default(GROUP)
  isPublic    Boolean  @default(true)
  inviteCode  String?  @unique // New field for invite links
  
  messages    Message[]
  members     ChannelMember[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
}

model ChannelMember {
  id          String   @id @default(uuid())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  role        ChannelRole @default(MEMBER)
  
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])
  @@index([role])
}

enum ChannelType {
  GROUP       // Regular group/channel
  DISCUSSION  // Discussion room
  SUPPORT     // Support channel
  ANNOUNCEMENTS // Announcements channel
}

enum ChannelRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}